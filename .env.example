# AdFlow — environment variables
#
# Copy to .env.local for local dev. In production these live in Vercel:
# Project → Settings → Environment Variables. Never commit real values.
#
# NEXT_PUBLIC_* are exposed to the browser. Everything else is server-only
# and must never be imported into a client component.

# ---------------------------------------------------------------------------
# Supabase — create a NEW project in your own org. Nothing to recover.
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Meta Marketing API — THE ONLY CREDENTIAL THAT IS HARD TO REPLACE.
# One long-lived Business Manager system-user token with asset access to every
# client ad account and Page. Not per-client, no OAuth. (SPEC.md §9 rule 11)
# Business Settings → Users → System Users → Generate New Token
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=

# Optional. Not used in any Graph call today, but needed to debug or extend a
# token. App Dashboard → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# One version for the whole app. The old build mixed v19.0 and v21.0 across
# files (SPEC.md §6). Not a secret.
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# AI — all self-serve. Create fresh keys, nothing to recover.
# ---------------------------------------------------------------------------

# Ad copy generation. console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Image generation. Replaces the Lovable AI Gateway, which is
# platform-specific and goes away with the Lovable project.
# platform.openai.com → API keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Cloudinary — ONLY if it survives the rebuild (PLAN.md §7 open question 2).
# It exists solely to stamp a tagline bar and promo pill onto images, which
# Next.js can do server-side with sharp/satori. Leave blank if we drop it.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# NOT NEEDED — do not go looking for these:
#   LOVABLE_API_KEY     dies with the Lovable project; replaced by OPENAI_API_KEY
#   FAL_API_KEY         dead since the fal.ai UI was removed
#   PERPLEXITY_API_KEY  never used; pain_points table has 0 rows
#   GOOGLE_*            the autofill model moves to Claude; one less vendor
# ---------------------------------------------------------------------------
